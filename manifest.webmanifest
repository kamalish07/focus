    },
    {
      "src": "store/screenshot-4-stats.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Statistics by week, month and year"
    },
    {
      "src": "store/screenshot-5-looks.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
